# Copy to /opt/forecast/deploy/ubuntu/forecast.env (systemd EnvironmentFile).
# Основные секреты — в /opt/forecast/.env (см. .env.example в корне репо).
# Combined scan: тренд + флет (configs/config.yaml → trend_scan, auto_trade).

FORECAST_CONFIG=/opt/forecast/configs/config.yaml
FORECAST_TIMEFRAME=1h
FORECAST_BARS=1000
FORECAST_TOP=20
FORECAST_STAGE1_MIN_SCORE=18
FORECAST_USE_FILTERED=1
FORECAST_USE_CLOSED_BAR=1
FORECAST_LONG_ONLY=1
FORECAST_ALLOW_TREND=1
FORECAST_ALLOW_RANGE=1
FORECAST_MIN_PROB_PCT=50
TREND_LOOKBACK=60
TREND_MIN_MOVE_PCT=0.008
TREND_MIN_REL_VOLUME=1.2

# Auto-trade overrides (ключи AUTO_TRADE_* — в /opt/forecast/.env)
# AUTO_TRADE_ENABLED=true
# AUTO_TRADE_DRY_RUN=true
# AUTO_TRADE_MARKET=spot
