[Unit]
Description=Forecast scanner web API (uvicorn)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=forecast
Group=forecast
WorkingDirectory=/opt/forecast
Environment=PYTHONUNBUFFERED=1
Environment=PATH=/opt/forecast/.venv/bin:/usr/bin
EnvironmentFile=-/opt/forecast/.env
ExecStart=/opt/forecast/.venv/bin/python -m uvicorn forecast.api:app --host 0.0.0.0 --port 8000
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
