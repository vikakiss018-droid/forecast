# Данные / сканер (read-only или общий ключ)
BINANCE_API_KEY=your_api_key_here
BINANCE_API_SECRET=your_api_secret_here

# Торговля Spot — отдельный ключ с правом Spot Trade (без Withdraw)
BINANCE_TRADE_API_KEY=your_trade_api_key_here
BINANCE_TRADE_API_SECRET=your_trade_api_secret_here

PANEL_AUTH_USER=admin
PANEL_AUTH_PASSWORD=your_strong_panel_password

# Мобильное приложение /m — уведомление, если score сетапа выше порога
MOBILE_ALERT_MIN_SCORE=35
# MOBILE_VAPID_MAILTO=mailto:you@example.com

# === Эталон бэктеста (справочно, повторить прогон) ===
# MULTI_BT_USE_FILTERED=1 MULTI_BT_DEPOSIT=300 MULTI_BT_RISK_PCT=0.5 MULTI_BT_TARGET_TRADES=100
# MULTI_BT_TARGET_TRADES=0   # без лимита: все сигналы за ~1000 баров 1h на каждую пару
# MULTI_BT_START=2026-05-01 MULTI_BT_END=2026-05-10   # только входы в этом окне (UTC)
# python -m forecast.run_multi_symbol_backtest

# === Combined scan: тренд + флет (configs/config.yaml → trend_scan) ===
FORECAST_CONFIG=configs/config.yaml
FORECAST_TIMEFRAME=1h
FORECAST_BARS=1000
FORECAST_TOP=20
FORECAST_STAGE1_MIN_SCORE=18
FORECAST_USE_FILTERED=1
FORECAST_USE_CLOSED_BAR=1
FORECAST_LONG_ONLY=0
FORECAST_ALLOW_TREND=1
FORECAST_ALLOW_RANGE=1
FORECAST_MIN_PROB_PCT=50
# 0 = выкл prob-фильтр в validate_setup (только stage1 + RR + rel_vol)
TREND_LOOKBACK=60
TREND_MIN_MOVE_PCT=0.008
TREND_MIN_REL_VOLUME=1.2
TREND_MIN_ATR_PCT=0
# 0 = выкл ATR-фильтр; AUTO_TRADE_MIN_SCORE=0 = без дубля stage1 в validate_setup

# === Тест пар (панель /scanner/pairs, python -m forecast.run_symbol_ranking) ===
RANK_TOP_N=400
RANK_TARGET_PER_SYMBOL=30
# RANK_STAGE1_RELAX_SCORE=12   # fallback stage1 если 0 сделок на паре

# === Order book (spot depth, top-N live pairs) ===
ORDERBOOK_TOP_N=8
ORDERBOOK_OBI_LEVELS=10
ORDERBOOK_OBI_EMA_TICKS=25
ORDERBOOK_OBI_LONG_MIN=0.12
ORDERBOOK_OBI_SHORT_MAX=-0.12
ORDERBOOK_MAX_SPREAD_BPS=25
ORDERBOOK_STALE_SEC=5
ORDERBOOK_GATE_ENABLED=0

# === Scalp (event-driven, independent of 1h scan) ===
SCALP_ENABLED=1
SCALP_DRY_RUN=true
SCALP_OBI_LONG_MIN=0.15
SCALP_OBI_SHORT_MAX=-0.15
SCALP_OBI_PERSIST_SEC=3
SCALP_MAX_SPREAD_BPS=15
SCALP_STALE_SEC=5
SCALP_COOLDOWN_SEC=45
SCALP_MAX_TRADES_PER_HOUR=12
SCALP_MAX_TRADES_PER_DAY=80
SCALP_MIN_TP_PCT=0.35
SCALP_SL_PCT=0.25
SCALP_TIME_STOP_SEC=90
SCALP_AGG_FLOW_WINDOW_SEC=5
SCALP_AGG_FLOW_MIN_RATIO=1.3
SCALP_REQUIRE_AGG_FLOW=0
SCALP_SPOT_ALLOW_SHORT=false
SCALP_TICK_LOG=0
SCALP_PAPER_NOTIONAL_USDT=30
SCALP_ROUND_TRIP_FEE_PCT=0.2
SCALP_USE_DEDICATED_LIST=1

# === Scalp pair ranking (400 → top-8 for orderbook/scalp engine) ===
SCALP_RANK_TOP_N=400
SCALP_RANK_BARS_1M=1000
SCALP_RANK_TARGET=8
SCALP_RANK_SIM_STEP=45
SCALP_RANK_REFINE_TOP=40

# === Auto-trade (configs/config.yaml → auto_trade) ===
AUTO_TRADE_ENABLED=false
AUTO_TRADE_DRY_RUN=true
AUTO_TRADE_MARKET=spot
AUTO_TRADE_MIN_SCORE=18
AUTO_TRADE_MIN_PROB_PCT=50
AUTO_TRADE_MIN_RR=1.5
AUTO_TRADE_RISK_PCT=0.5
AUTO_TRADE_MAX_NOTIONAL_USDT=50
AUTO_TRADE_COOLDOWN_MINUTES=0
AUTO_TRADE_LEVERAGE=1
AUTO_TRADE_TOP_N=10
AUTO_TRADE_MAX_POSITIONS=6
AUTO_TRADE_PROFIT_CLOSE_PCT=0
AUTO_TRADE_ALLOW_LEVEL_BREAKOUT=false
AUTO_TRADE_ALLOW_TRIANGLE=false
AUTO_TRADE_ALLOWED_HOURS=
AUTO_TRADE_MIN_ATR_PCT=0
AUTO_TRADE_STOP_LOSS_ROI_USDT=0
AUTO_TRADE_SPOT_ALLOW_SHORT=false

# Ранжирование пар (перед первым запуском и периодически)
# python -m forecast.run_symbol_ranking
# Параметры: RANK_TOP_N, FORECAST_TIMEFRAME, FORECAST_BARS, FORECAST_* (как live-скан)
