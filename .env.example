# Данные / сканер (read-only или общий ключ)
BINANCE_API_KEY=your_api_key_here
BINANCE_API_SECRET=your_api_secret_here

# Торговля Spot — отдельный ключ с правом Spot Trade (без Withdraw)
BINANCE_TRADE_API_KEY=your_trade_api_key_here
BINANCE_TRADE_API_SECRET=your_trade_api_secret_here

PANEL_AUTH_USER=admin
PANEL_AUTH_PASSWORD=your_strong_panel_password

# === Эталон бэктеста (справочно, повторить прогон) ===
# MULTI_BT_USE_FILTERED=1 MULTI_BT_DEPOSIT=300 MULTI_BT_RISK_PCT=0.5 MULTI_BT_TARGET_TRADES=100
# python -m forecast.run_multi_symbol_backtest

# === Тренд-скан (configs/config.yaml → trend_scan) ===
FORECAST_CONFIG=configs/config.yaml
FORECAST_TIMEFRAME=1h
FORECAST_BARS=1000
FORECAST_TOP=20
FORECAST_STAGE1_MIN_SCORE=18
FORECAST_USE_FILTERED=1
FORECAST_USE_CLOSED_BAR=1
FORECAST_LONG_ONLY=1
FORECAST_MIN_PROB_PCT=50
TREND_LOOKBACK=60
TREND_MIN_MOVE_PCT=0.008
TREND_MIN_REL_VOLUME=1.2

# === Auto-trade (configs/config.yaml → auto_trade) ===
AUTO_TRADE_ENABLED=false
AUTO_TRADE_DRY_RUN=true
AUTO_TRADE_MARKET=spot
AUTO_TRADE_MIN_SCORE=18
AUTO_TRADE_MIN_PROB_PCT=50
AUTO_TRADE_MIN_RR=1.5
AUTO_TRADE_RISK_PCT=0.5
AUTO_TRADE_MAX_NOTIONAL_USDT=50
AUTO_TRADE_COOLDOWN_MINUTES=0
AUTO_TRADE_LEVERAGE=1
AUTO_TRADE_TOP_N=10
AUTO_TRADE_MAX_POSITIONS=6
AUTO_TRADE_PROFIT_CLOSE_PCT=0
AUTO_TRADE_ALLOW_LEVEL_BREAKOUT=false
AUTO_TRADE_ALLOW_TRIANGLE=false
AUTO_TRADE_ALLOWED_HOURS=
AUTO_TRADE_MIN_ATR_PCT=0
AUTO_TRADE_STOP_LOSS_ROI_USDT=0
AUTO_TRADE_SPOT_ALLOW_SHORT=false

# Ранжирование 50 пар (перед первым запуском и периодически)
# python -m forecast.run_symbol_ranking
