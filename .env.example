# Данные / сканер (можно read-only или общий ключ)
BINANCE_API_KEY=your_api_key_here
BINANCE_API_SECRET=your_api_secret_here

# Торговля на Futures — отдельный ключ с правом Futures (рекомендуется)
BINANCE_TRADE_API_KEY=your_trade_api_key_here
BINANCE_TRADE_API_SECRET=your_trade_api_secret_here

# Панель /scanner (HTTP Basic Auth). Пароль задайте на сервере — не коммитьте.
PANEL_AUTH_USER=admin
PANEL_AUTH_PASSWORD=your_strong_panel_password

# Auto-trade (Binance USDT-M Futures, long/short from scanner). Start with dry-run!
AUTO_TRADE_ENABLED=false
AUTO_TRADE_DRY_RUN=true
AUTO_TRADE_MIN_SCORE=55
AUTO_TRADE_MIN_PROB_PCT=55
AUTO_TRADE_MIN_RR=1.5
AUTO_TRADE_RISK_PCT=0.5
AUTO_TRADE_MAX_NOTIONAL_USDT=50
AUTO_TRADE_COOLDOWN_MINUTES=240
AUTO_TRADE_LEVERAGE=5
AUTO_TRADE_MARGIN_MODE=isolated
AUTO_TRADE_TOP_N=4
AUTO_TRADE_MAX_POSITIONS=3
AUTO_TRADE_PROFIT_CLOSE_PCT=10
# true = можно открывать на ретест/пробой уровня; false = пропускать такие сетапы
AUTO_TRADE_ALLOW_LEVEL_BREAKOUT=true
# true = можно открывать по паттерну triangle; false = пропускать такие сетапы
AUTO_TRADE_ALLOW_TRIANGLE=true
# Часы входа UTC: 8-20 = EU+US; all или пусто = без ограничения
AUTO_TRADE_ALLOWED_HOURS=8-20
# Min ATR/close для входа (0.008 = 0.8%); 0 = выкл
AUTO_TRADE_MIN_ATR_PCT=0.008
# Макс. убыток uPnL в USDT; 5 = закрыть при −5 USDT; 0 = выкл (остаётся стоп на бирже из плана)
AUTO_TRADE_STOP_LOSS_ROI_USDT=0
